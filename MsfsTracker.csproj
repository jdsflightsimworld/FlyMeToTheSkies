<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- SimConnect es una DLL nativa de 64 bits: el proceso debe ser x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Ruta del SDK de MSFS 2024. El instalador del SDK suele crear la variable
         de entorno MSFS2024_SDK; si no existe, se usa la ruta por defecto. -->
    <MsfsSdk Condition="'$(MSFS2024_SDK)' != ''">$(MSFS2024_SDK)</MsfsSdk>
    <MsfsSdk Condition="'$(MsfsSdk)' == ''">C:\MSFS 2024 SDK\</MsfsSdk>
    <MsfsSdk>$([MSBuild]::EnsureTrailingSlash('$(MsfsSdk)'))</MsfsSdk>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wrapper .NET de SimConnect -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MsfsSdk)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>

    <!-- DLL nativa que usa el wrapper: tiene que estar junto al .exe -->
    <None Include="$(MsfsSdk)SimConnect SDK\lib\SimConnect.dll"
          Link="SimConnect.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
